{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "pin",
	"description": "Capability para las ventanas pin-* de capturas fijadas",
	"windows": ["pin-*"],
	"permissions": [
		"core:window:allow-close",
		"core:window:allow-start-dragging",
		"core:window:allow-set-focus",
		"allow-get-pin-image",
		"allow-close-pin"
	]
}
