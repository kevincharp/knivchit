{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "capture-overlay",
	"description": "Capability para la ventana overlay de selección de captura",
	"windows": ["capture-overlay"],
	"permissions": [
		"core:window:allow-close",
		"core:window:allow-show",
		"core:window:allow-hide",
		"core:window:allow-set-focus",
		"core:webview:allow-set-webview-focus",
		"allow-get-capture-preview",
		"allow-cancel-capture",
		"allow-capture-activity",
		"allow-save-capture",
		"allow-save-capture-as",
		"allow-copy-capture",
		"allow-pin-capture"
	]
}
